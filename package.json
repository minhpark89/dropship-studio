{
  "name": "dropship-studio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Dropship Studio",
  "description": "Tạo video AI với Dola, Google Flow và dựng video cục bộ",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "vite build",
    "desktop": "electron .",
    "pack": "npm run pack:portable",
    "pack:portable": "npm run build && electron-builder --win portable --publish never",
    "pack:installer": "npm run build && electron-builder --win nsis --publish never",
    "pack:release": "npm run build && electron-builder --win nsis portable --publish never",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.dropship.studio",
    "productName": "Dropship Studio",
    "directories": { "output": "release" },
    "files": ["desktop/**", "server/**", "shared/**", "dist/**", "build/**", "package.json"],
    "extraResources": [{ "from": "bin", "to": "bin", "filter": ["*.exe", "*.txt"] }],
    "asarUnpack": ["node_modules/playwright*/**"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dropship Studio",
      "artifactName": "Dropship Studio Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Dropship Studio ${version}.${ext}"
    }
  }
}
