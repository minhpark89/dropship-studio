{
  "name": "viral-studio",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Viral Studio",
  "description": "Research news, product video and social content workspace with DreamFace",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "vite build",
    "desktop": "electron .",
    "pack": "npm run pack:portable",
    "pack:portable": "npm run build && electron-builder --win portable --publish never",
    "pack:installer": "npm run build && electron-builder --win nsis --publish never",
    "pack:release": "npm run build && electron-builder --win nsis portable --publish never",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs",
    "test:workspaces": "node tests/workspaces-browser.mjs",
    "test:sample-render": "node tests/sample-render.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.viral.studio",
    "productName": "Viral Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "dist/**",
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe",
          "*.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/playwright*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viral Studio",
      "artifactName": "Viral Studio Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Viral Studio ${version}.${ext}"
    }
  }
}
